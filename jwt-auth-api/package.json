{
  "name": "jwt-auth-api",
  "version": "1.0.0",
  "description": "Authentication API with short-lived JWTs, rotating refresh tokens, roles and OpenAPI docs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.5",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
