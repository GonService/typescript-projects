{
  "name": "realtime-chat",
  "version": "1.0.0",
  "description": "WebSocket chat with rooms, typing indicator, history and flood protection",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "ws": "^8.22.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
