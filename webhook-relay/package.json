{
  "name": "webhook-relay",
  "version": "1.0.0",
  "description": "Receives webhooks, verifies HMAC signatures and delivers them reliably with retries",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.5",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
