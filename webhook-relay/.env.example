# Token for the /admin API (at least 16 characters): openssl rand -hex 24
ADMIN_TOKEN=change-me-to-a-long-random-token
# One entry per provider: POST /webhooks/<name> with the HMAC-SHA256 signature in the header
WEBHOOK_SOURCES={"shop":{"secret":"change-me","target":"https://erp.example.com/api/webhooks"},"payments":{"secret":"change-me-too","target":"https://erp.example.com/api/payments","signatureHeader":"x-hub-signature-256"}}
MAX_ATTEMPTS=8
BASE_BACKOFF_MS=2000
DELIVERY_TIMEOUT_MS=10000
